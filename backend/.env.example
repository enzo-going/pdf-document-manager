# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me

# JWT Authentication
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRES=1
JWT_REFRESH_TOKEN_EXPIRES=30

# Database (SQLite para desenvolvimento)
DATABASE_URL=sqlite:///app.db

# Storage
UPLOAD_FOLDER=storage/temp
ORIGINALS_FOLDER=storage/originals
PROCESSED_FOLDER=storage/processed
MAX_FILE_SIZE=52428800

# Organização
COMPANY_NAME=Example Organization
DEFAULT_LOCATION=Example City
ID_PREFIX=ORG

# Usuário administrador (criado no primeiro start)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# DocuSign eSignature API (opcional)
SIGNATURE_PROVIDER=docusign
SIGNATURE_API_URL=https://demo.docusign.net/restapi
DOCUSIGN_INTEGRATION_KEY=your-integration-key
DOCUSIGN_USER_ID=your-user-id
DOCUSIGN_ACCOUNT_ID=your-account-id
DOCUSIGN_CLIENT_SECRET=your-client-secret
DOCUSIGN_PRIVATE_KEY_PATH=certs/private-key.pem
DOCUSIGN_REDIRECT_URI=http://localhost:5000/callback
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi

# CORS (origens permitidas, separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
